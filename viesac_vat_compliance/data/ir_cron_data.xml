<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Scheduled Action: Refresh Open/Pending Audits (Every 10 minutes) -->
    <record id="ir_cron_viesac_refresh_open_audits" model="ir.cron">
        <field name="name">VIESAC: Refresh Open Audits</field>
        <field name="model_id" ref="model_viesac_audit_log"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_open_audits()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Scheduled Action: Synchronize Global VAT Rates (Daily) -->
    <record id="ir_cron_viesac_sync_rates" model="ir.cron">
        <field name="name">VIESAC: Synchronize Global VAT Rates</field>
        <field name="model_id" ref="model_viesac_vat_rate"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_vat_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
